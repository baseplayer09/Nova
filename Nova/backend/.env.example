PORT=3000
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY="your-publishable-key"
# Server-only key used to delete Auth users. Never expose it to Flutter.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_DIRECT_HOST:5432/postgres"
# Workers Free provides a daily inference allowance; requests stop at its quota.
AI_PROVIDER="cloudflare"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-workers-ai-api-token"
# Optional paid provider; set AI_PROVIDER="openai" to use it.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
PIN_PEPPER="replace-with-a-random-secret-at-least-32-characters-long"
# Base64-encoded 32-byte key used to wrap per-profile encryption keys.
MEMORY_KEK="base64-encoded-32-byte-key"
# Google OAuth web client. The callback URL must exactly match the Google Cloud
# Console redirect URI; use a deployed HTTPS backend for live authorization.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="https://YOUR_BACKEND_HOST/api/integrations/google/callback"
NOVA_APP_ORIGIN="https://YOUR_APP_HOST"
# Optional public HTTPS Home Assistant URL; user access tokens are encrypted per profile.
HOME_ASSISTANT_URL="https://home.example.com"
CORS_ORIGIN="*"
